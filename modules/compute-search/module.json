{
  "schema_version": 1,
  "id": "compute-search",
  "version": "0.1.0",
  "kind": "workhub-module",
  "name": {
    "zh-CN": "算力产业链研究",
    "en": "Compute investment research"
  },
  "python": ">=3.10",
  "entrypoints": {
    "collect": "bin/collect.py",
    "build": "bin/build_data.py"
  },
  "site": {
    "entry": "site/index.html",
    "layout": "library",
    "generated": true
  },
  "files": [
    "module.json",
    "README.md",
    "README.en.md",
    "bin/collect.py",
    "bin/build_data.py",
    "config.example.json",
    "research.json",
    "site.template.html",
    "site/design-system.css",
    "site/embedded-theme.js",
    "docs/research.md",
    "docs/research.en.md",
    "prompts/research-brief.md",
    "prompts/research-brief.en.md"
  ],
  "runtime_excluded": [
    "data/",
    "logs/",
    "site/index.html",
    "module-install.json",
    "config.json"
  ],
  "installation": {
    "executes_code": false,
    "collects_news": false,
    "creates_automations": false,
    "updates_global_agent_rules": false
  }
}
