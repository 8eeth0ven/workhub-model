{
  "schema_version": 1,
  "id": "industry-atlas",
  "version": "0.1.0",
  "kind": "workhub-module",
  "name": {
    "zh-CN": "产业知识图谱",
    "en": "Industry evidence atlas"
  },
  "python": ">=3.10",
  "entrypoints": {
    "import": "bin/import_data.py",
    "build": "bin/build_data.py"
  },
  "site": {
    "entry": "site/index.html",
    "layout": "library",
    "generated": true
  },
  "files": [
    "module.json",
    "bin/atlas_core.py",
    "bin/import_data.py",
    "bin/build_data.py",
    "starter.json",
    "site.template.html",
    "site/design-system.css",
    "site/embedded-theme.js",
    "README.md",
    "README.en.md",
    "docs/guide.md",
    "docs/guide.en.md",
    "prompts/industry-research.md",
    "prompts/industry-research.en.md"
  ],
  "runtime_excluded": [
    "data/",
    "logs/",
    "site/index.html",
    "module-install.json",
    "__pycache__/",
    ".industry-atlas.lock"
  ],
  "installation": {
    "executes_code": false,
    "collects_news": false,
    "creates_automations": false,
    "updates_global_agent_rules": false
  }
}
